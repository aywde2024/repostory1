```gitignore
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyc
*.py~
*.py.class
*.so
*.o
*.a
*.obj
*.out
*.dll
*.exe

# Dependencies
venv/
.venv/
.env
.env.local
*.env.*

# Build and distribution
build/
dist/
*.egg-info/

# Testing and coverage
.coverage
coverage/
htmlcov/
.pytest_cache/
.mypy_cache/

# Logs
*.log

# OS generated files
.DS_Store
Thumbs.db

# Editor specific
.vscode/
.idea/
*.swp
*.swo
*.tmp
```