# PRADA Agent Environment Variables Template
# Copy this file to ~/.prada/.env and fill in your credentials

# =============================================================================
# LLM Provider Credentials
# =============================================================================

# OpenRouter (recommended default)
OPENROUTER_API_KEY=sk-or-v1-your-key-here

# OpenAI
OPENAI_API_KEY=sk-proj-your-key-here

# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Google Gemini
GEMINI_API_KEY=AIzaSyDyour-key-here

# xAI (Grok)
XAI_API_KEY=xai-your-key-here

# Moonshot (Kimi)
MOONSHOT_API_KEY=kimi-your-key-here

# MiniMax
MINIMAX_API_KEY=minimax-your-key-here

# Zhipu (GLM)
ZHIPU_API_KEY=zhipu-your-key-here

# Together AI
TOGETHER_API_KEY=together-your-key-here

# Fireworks AI
FIREWORKS_API_KEY=fireworks-your-key-here

# Groq
GROQ_API_KEY=groq-your-key-here

# DeepSeek
DEEPSEEK_API_KEY=deepseek-your-key-here

# Mistral AI
MISTRAL_API_KEY=mistral-your-key-here

# Cohere
COHERE_API_KEY=cohere-your-key-here

# Custom provider (if using custom endpoint)
CUSTOM_API_KEY=your-custom-key-here
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1

# =============================================================================
# Message Platform Credentials
# =============================================================================

# Telegram Bot API
TELEGRAM_BOT_TOKEN=123456789:AAHyour-token-here

# Discord Bot Token
DISCORD_BOT_TOKEN=MTIzNDU2Nzg5.your-token-here

# Slack Bot Token
SLACK_BOT_TOKEN=xoxb-your-token-here

# WhatsApp Cloud API
WHATSAPP_TOKEN=EAAByour-token-here
WHATSAPP_PHONE_ID=your-phone-id

# Twilio (SMS fallback)
TWILIO_ACCOUNT_SID=ACyour-sid-here
TWILIO_AUTH_TOKEN=your-auth-token-here
TWILIO_PHONE_NUMBER=+15551234567

# Signal CLI (requires signal-cli bridge)
SIGNAL_PHONE_NUMBER=+15551234567

# Email (IMAP/SMTP)
EMAIL_IMAP_SERVER=imap.example.com
EMAIL_SMTP_SERVER=smtp.example.com
EMAIL_ADDRESS=your-email@example.com
EMAIL_PASSWORD=your-email-password

# Matrix
MATRIX_HOMESERVER_URL=https://matrix.example.com
MATRIX_USER_ID=@user:matrix.example.com
MATRIX_ACCESS_TOKEN=your-access-token-here

# Mattermost
MATTERMOST_BASE_URL=https://mattermost.example.com
MATTERMOST_TOKEN=your-token-here

# Home Assistant
HOMEASSISTANT_URL=http://homeassistant.local:8123
HOMEASSISTANT_TOKEN=your-long-lived-token

# BlueBubbles (iMessage bridge)
BLUEBUBBLES_URL=http://localhost:5000
BLUEBUBBLES_TOKEN=your-token-here

# WeCom (Enterprise WeChat)
WECOM_CORP_ID=your-corp-id
WECOM_AGENT_ID=your-agent-id
WECOM_SECRET=your-secret

# Feishu/Lark
FEISHU_APP_ID=your-app-id
FEISHU_APP_SECRET=your-app-secret

# DingTalk
DINGTALK_ACCESS_TOKEN=your-access-token

# =============================================================================
# Terminal Backend Configuration
# =============================================================================

# SSH Backend (if using SSH terminal)
TERMINAL_SSH_HOST=server.example.com
TERMINAL_SSH_USER=prada
TERMINAL_SSH_PORT=22
TERMINAL_SSH_KEY_PATH=~/.ssh/prada_id

# Docker Backend (if using Docker)
TERMINAL_DOCKER_IMAGE=prada-agent:latest

# Modal Cloud Backend
MODAL_TOKEN_ID=your-modal-token-id
MODAL_TOKEN_SECRET=your-modal-token-secret

# Daytona Cloud Backend
DAYTONA_API_KEY=your-daytona-api-key
DAYTONA_WORKSPACE_ID=your-workspace-id

# Singularity Backend
SINGULARITY_IMAGE_PATH=/opt/images/prada.sif

# =============================================================================
# Memory Provider Configuration
# =============================================================================

# Mem0 (vector memory)
MEM0_VECTOR_DB=chroma
MEM0_COLLECTION=prada_memories
MEM0_EMBEDDING_MODEL=text-embedding-3-small

# Neo4j (for OpenViking knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password

# ChromaDB (standalone)
CHROMADB_HOST=localhost
CHROMADB_PORT=8000

# Weaviate (for Holographic memory)
WEAVIATE_URL=http://localhost:8080
WEAVIATE_API_KEY=your-weaviate-key

# PostgreSQL (for RetainDB)
POSTGRES_CONNECTION_STRING=postgresql://user:pass@localhost:5432/prada_memories

# =============================================================================
# Gateway Configuration
# =============================================================================

# Allowed users (whitelist mode)
# GATEWAY_ALLOWED_USERS_TELEGRAM=123456789,987654321
# GATEWAY_ALLOWED_USERS_DISCORD=123456789012345678
# GATEWAY_ALLOWED_USERS_SIGNAL=+15551234567
# GATEWAY_ALLOWED_USERS_EMAIL=trusted@example.com

# Home channel for notifications
GATEWAY_HOME_CHAT_PLATFORM=telegram
GATEWAY_HOME_CHAT_ID=123456789

# Allow all users (NOT recommended for production)
# GATEWAY_ALLOW_ALL_USERS=false

# =============================================================================
# Custom Configuration
# =============================================================================

# Override default PRADA home directory
# PRADA_HOME=~/.prada

# Default profile name
# PRADA_PROFILE=default

# Skills external directories
# SKILLS_REPO=/path/to/skills/repo

# Enable debug logging
# PRADA_DEBUG=true

# =============================================================================
# Cron & Batch Processing
# =============================================================================

# Default delivery for cron job results
CRON_DEFAULT_DELIVERY_PLATFORM=telegram
CRON_DEFAULT_DELIVERY_CHAT_ID=${GATEWAY_HOME_CHAT_ID}

# Batch processing configuration
BATCH_MAX_PARALLEL=4
BATCH_TIMEOUT_SECONDS=300
